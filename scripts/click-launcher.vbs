' dsh-task-toast click launcher.
'
' Windows runs this file through wscript.exe (a signed GUI-subsystem host) when a
' task notification is clicked. It starts focus.ps1 with a hidden console, so no
' terminal window is ever created on Windows 11 (where the default terminal host
' would otherwise show Windows Terminal before -WindowStyle Hidden takes effect).
' The launcher itself opens no window and only accepts the plugin's own URI shape.
Option Explicit

Dim uri
If WScript.Arguments.Count = 0 Then WScript.Quit 0
uri = WScript.Arguments(0)
If Len(uri) > 512 Then WScript.Quit 0
If Not IsValidUri(uri) Then WScript.Quit 0

Dim base, focus, fso, shell, ps, command
base = Left(WScript.ScriptFullName, InStrRev(WScript.ScriptFullName, "\"))
focus = base & "focus.ps1"
Set fso = CreateObject("Scripting.FileSystemObject")
If Not fso.FileExists(focus) Then WScript.Quit 0
Set shell = CreateObject("WScript.Shell")
ps = shell.ExpandEnvironmentStrings("%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe")
If Not fso.FileExists(ps) Then WScript.Quit 0

command = """" & ps & """ -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File """ & focus & """ """ & uri & """"
shell.Run command, 0, False
WScript.Quit 0

' The URI is generated by the Host plugin (encodeURIComponent of session.id), so
' only URL-safe characters may arrive here; anything else is rejected. Quoting the
' URI into the PowerShell command line is only safe because of this check.
Function IsValidUri(value)
  Dim re
  Set re = New RegExp
  re.Pattern = "^dsh-task-toast://focus/[A-Za-z0-9%._~!$&'()*+,;=:@/-]+$"
  re.IgnoreCase = True
  IsValidUri = re.Test(value)
End Function
